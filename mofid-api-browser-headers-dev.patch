diff --git a/lib/src/shared/network/mofid_api_headers.dart b/lib/src/shared/network/mofid_api_headers.dart
new file mode 100644
index 0000000..5888d36
--- /dev/null
+++ b/lib/src/shared/network/mofid_api_headers.dart
@@ -0,0 +1,17 @@
+const String mofidBrowserUserAgent =
+    'Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:155.0) '
+    'Gecko/20100101 Firefox/155.0';
+
+Map<String, dynamic> mofidApiHeaders(String accessToken) {
+  return <String, dynamic>{
+    'Authorization': 'Bearer $accessToken',
+    'Accept': 'application/json, text/plain, */*',
+    'Accept-Language': 'fa',
+    'Origin': 'https://m.easytrader.ir',
+    'Referer': 'https://m.easytrader.ir/',
+    'User-Agent': mofidBrowserUserAgent,
+    'Sec-Fetch-Dest': 'empty',
+    'Sec-Fetch-Mode': 'cors',
+    'Sec-Fetch-Site': 'same-site',
+  };
+}
diff --git a/test/shared/network/mofid_api_headers_test.dart b/test/shared/network/mofid_api_headers_test.dart
new file mode 100644
index 0000000..5a93fd4
--- /dev/null
+++ b/test/shared/network/mofid_api_headers_test.dart
@@ -0,0 +1,22 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:portfolio/src/shared/network/mofid_api_headers.dart';
+
+void main() {
+  test('mofidApiHeaders matches the browser request shape captured in HAR', () {
+    final headers = mofidApiHeaders('token-value');
+
+    expect(headers['Authorization'], 'Bearer token-value');
+    expect(headers['Accept'], 'application/json, text/plain, */*');
+    expect(headers['Accept-Language'], 'fa');
+    expect(headers['Origin'], 'https://m.easytrader.ir');
+    expect(headers['Referer'], 'https://m.easytrader.ir/');
+    expect(
+      headers['User-Agent'],
+      'Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:155.0) '
+      'Gecko/20100101 Firefox/155.0',
+    );
+    expect(headers['Sec-Fetch-Dest'], 'empty');
+    expect(headers['Sec-Fetch-Mode'], 'cors');
+    expect(headers['Sec-Fetch-Site'], 'same-site');
+  });
+}
